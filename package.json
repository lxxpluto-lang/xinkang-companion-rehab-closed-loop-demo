{
  "name": "xinkang-companion-rehab-closed-loop-demo",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:fullstack": "concurrently -k -n SERVER,WEB -c green,blue \"npm:dev:server\" \"npm:dev:web\"",
    "build": "tsc -b && vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node server-dist/server/index.js",
    "preview": "vite preview --config vite.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "fullstack": "docker compose up --build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.12.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
